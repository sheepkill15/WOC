{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Windows Orphan Cleaner",
  "version": "0.1.0",
  "identifier": "dev.orphancleaner.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Windows Orphan Cleaner", "width": 1180, "height": 760, "minWidth": 900, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": { "active": false }
}

